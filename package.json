{
  "name": "soloteam-cli",
  "version": "0.1.0",
  "description": "Config sync and friction-based memory nudges for solo developers running Claude Code (or other agent CLIs). Inspired by Tencent's teamai-cli, rebuilt for a team of one.",
  "type": "module",
  "bin": {
    "soloteam": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --outfile dist/soloteam"
  },
  "dependencies": {
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orkhan-j/soloteam-cli"
  },
  "keywords": ["claude-code", "agent-cli", "dotfiles-sync", "solo-dev"]
}
